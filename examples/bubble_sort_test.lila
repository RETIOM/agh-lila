fn bubble_sort(int xs[8]) -> void {
    while true {
        bool swapped = false;
        for int i in 0..7 {
            if xs[i] > xs[i + 1] {
                int tmp = xs[i];
                xs[i] = xs[i + 1];
                xs[i + 1] = tmp;
                swapped = true;
            }
        }
        if !swapped { break; }
    }
    return;
}

fn main() -> int {
    int xs[8];
    xs[0] = 5;
    xs[1] = 3;
    xs[2] = 8;
    xs[3] = 1;
    xs[4] = 9;
    xs[5] = 2;
    xs[6] = 7;
    xs[7] = 4;

    bubble_sort(xs);

    for int i in 0..8 {
        println(xs[i]);
    }
    return 0;
}
